# ---------------------------------------------------------------------
# Inquiry API — environment
# ---------------------------------------------------------------------

PORT=3000

# --- our own database (NOT the Host App) -----------------------------
# Quote ledger, search log, synonyms. Owns nothing the Host App owns.
DATABASE_URL=postgres://user:pass@host:5432/inquiry_desk

# --- respond.io ------------------------------------------------------
# Token from respond.io > Settings > Integrations > Developer API.
RESPOND_TOKEN=
# Random string you invent. It goes in the webhook URL you register, so
# only respond.io knows the path: https://you/webhook/respond/<secret>
RESPOND_WEBHOOK_SECRET=
RESPOND_BASE=https://api.respond.io/v2

# Map respond.io channelId -> how we write for it.
# "rich"  = Messenger/Viber: peso sign, line breaks, longer.
# "sms"   = GSM-7 only, no peso sign, 160 chars.
# JSON: {"<channelId>":"sms"}  — anything unlisted is treated as rich.
CHANNEL_STYLE={}

# --- Host App (read-only, through RPCs) ------------------------------
HOST_APP_URL=https://<project>.supabase.co
HOST_APP_ANON_KEY=
# A dedicated Supabase auth user for this service, with VIEW on catalog
# and customers and nothing else. Never the service_role key — their
# row-level security and per-module permissions must still apply.
HOST_APP_BOT_EMAIL=inquiry-bot@janiceautosupply.ph
HOST_APP_BOT_PASSWORD=

# --- Claude (extraction only) ----------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- behaviour -------------------------------------------------------
# How long a quoted price stays locked for that customer.
QUOTE_VALID_HOURS=72

# Shadow mode. true = never message a customer; post a staff comment
# only. Leave this on until the numbers say otherwise.
SHADOW_MODE=true

# Once out of shadow, only these intents may auto-send. Everything else
# still lands as a comment for a person. Comma-separated.
AUTOSEND_INTENTS=store_info
